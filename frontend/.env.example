# ── Backend API URL ──────────────────────────────────────────
# Local development
VITE_API_BASE_URL=http://localhost:8000

# Production (Render deployment — fill in after deploy)
# VITE_API_BASE_URL=https://veriform-api.onrender.com

# ── Supabase (anon key only — service-role key stays on backend!) ──
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Feature flags ─────────────────────────────────────────────
# Set to 'true' to use mock data instead of hitting the real API (Day 1)
VITE_USE_MOCK_DATA=true
